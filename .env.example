# Copier en .env et renseigner. Ne jamais committer .env.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# E-mails transactionnels (Resend). EMAIL_FROM doit être une adresse d'un
# domaine vérifié chez Resend. Sans clé en développement, les e-mails
# s'affichent dans la console.
RESEND_API_KEY=
EMAIL_FROM=
